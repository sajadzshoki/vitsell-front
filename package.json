    "@unocss/nuxt": "66.8.0",
    "nuxt": "4.5.2",
    "nuxt-lodash": "2.5.3",
    "nuxt-swiper": "2.0.2",
    "patch-package": "^8.0.1",
    "sass": "1.102.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "overrides": {
