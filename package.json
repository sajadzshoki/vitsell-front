{
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:store": "nuxt build --dotenv .env.store",
    "build:admin": "nuxt build --dotenv .env.admin",
    "build:store:prod": "nuxt build --dotenv .env.store.production",
    "build:admin:prod": "nuxt build --dotenv .env.admin.production",
    "dev": "nuxt dev --port 4000 --dotenv .env.store",
    "dev:store": "nuxt dev --port 4000 --dotenv .env.store",
    "dev:admin": "nuxt dev --port 4001 --dotenv .env.admin",
    "generate": "nuxt generate --dotenv .env.store.production && node scripts/fix-spa-html.mjs",
    "generate:store": "nuxt generate --dotenv .env.store.production && node scripts/fix-spa-html.mjs",
    "generate:admin": "nuxt generate --dotenv .env.admin.production && node scripts/fix-spa-html.mjs",
    "generate:store:local": "nuxt generate --dotenv .env.store && node scripts/fix-spa-html.mjs",
    "generate:admin:local": "nuxt generate --dotenv .env.admin && node scripts/fix-spa-html.mjs",
    "generate:store:prod": "nuxt generate --dotenv .env.store.production && node scripts/fix-spa-html.mjs",
    "generate:admin:prod": "nuxt generate --dotenv .env.admin.production && node scripts/fix-spa-html.mjs",
    "preview": "nuxt preview",
    "postinstall": "patch-package && nuxt prepare"
  },
  "devDependencies": {
    "@iconify-json/tabler": "1.2.38",
